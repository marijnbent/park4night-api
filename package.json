{
  "name": "park4night-api",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./vault": {
      "types": "./dist/vault.d.ts",
      "import": "./dist/vault.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit",
    "api": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "mcp": "node src/mcp-cli.ts",
    "test:package": "npm run build && node --test test-package/*.test.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "description": "Park4night client, CLI, and read-only MCP server with native authentication and rate limits.",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "license": "MIT",
  "types": "./dist/client.d.ts",
  "bin": {
    "park4night": "./dist/cli.js",
    "park4night-mcp": "./dist/mcp-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marijnbent/park4night-api.git"
  }
}
